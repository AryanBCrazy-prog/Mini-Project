# QueueWise Email Configuration Template
# To test real emails locally, copy this file to `.streamlit/secrets.toml`
# and fill in your actual credentials.
# (Note: `.streamlit/secrets.toml` is ignored by git so your credentials stay safe!)

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-email@gmail.com"
SMTP_PASSWORD = "your-16-char-app-password"
